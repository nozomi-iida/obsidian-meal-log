# Basic 認証の資格情報。
#
# 2 つとも設定されているときだけ認証が有効になる。片方だけでは未設定として扱う。
# 手元では未設定のまま素通りするが、NODE_ENV=production では要求を通さない。
#
# このファイルは雛形なので値を書かない。実際の値は .env.local に置く。
# .env.local は .gitignore で追跡対象から外れている。

BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# vault への書き込みに使う設定。
#
# 3 つとも設定されているときだけ記録を試みる。欠けていれば未設定として扱い、
# 設定の不足として示す。保存先の Meals/items はコード側の定数なので変数にしない。
#
# VAULT_OWNER … vault リポジトリの所有者
# VAULT_REPO  … vault リポジトリの名前
# VAULT_TOKEN … vault への Contents: Read and write を持つ fine-grained PAT。
#               サーバー側でのみ読み、クライアントには渡さない

VAULT_OWNER=
VAULT_REPO=
VAULT_TOKEN=
